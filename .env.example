DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5433/herbalife
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MSG91 auth key for the WhatsApp messages (docs/whatsapp-messages.md). Leave
# it unset locally: nothing is sent without it.
# MSG91_AUTH_KEY=

# Bearer token Vercel Cron sends to /api/cron/package-reminder. Without it the
# route refuses every call, which is what local runs want.
# CRON_SECRET=
